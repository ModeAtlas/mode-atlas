rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Existing private save path. Friends never read this document.
    match /users/{uid}/appData/kanaTrainer {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Social collections are accessed only through authenticated callables.
    // Admin SDK operations enforce their own ownership and relationship checks.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
