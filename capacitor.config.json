{
  "appId": "app.modeatlas",
  "appName": "Mode Atlas",
  "webDir": ".build/ios-web",
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com",
        "apple.com"
      ]
    },
    "FirebaseMessaging": {
      "presentationOptions": []
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "packageOptions": {
          "@capacitor-firebase/authentication": {
            "symlink": true
          },
          "@capacitor-firebase/messaging": {
            "symlink": true
          }
        },
        "swiftToolsVersion": "6.1",
        "packageTraits": {
          "@capacitor-firebase/authentication": [
            "Google"
          ]
        }
      }
    }
  }
}
