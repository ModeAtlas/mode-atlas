// The app uses Sign in with Apple. Widget sharing is provisioned on each Mac;
// the extension never inherits the app's Apple sign-in entitlement.
#include "release.xcconfig"
MODE_ATLAS_APP_GROUP =
MODE_ATLAS_APP_ENTITLEMENTS = App/App.entitlements
MODE_ATLAS_WIDGET_ENTITLEMENTS = Shared/LocalOnly.entitlements
#include? "widget-sharing.local.xcconfig"
#include? "signing.local.xcconfig"
